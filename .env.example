# =============================================================================
#  Ganjuur — environment configuration template
# =============================================================================
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#   nano .env
#
# .env is in .gitignore and MUST NEVER be committed.
# =============================================================================

# ── Primary paths ────────────────────────────────────────────────────────────
# The single path that controls everything else.  Default is the live server.
GANJUUR_BASE_DIR=/home/trinity/ganjuur

# Override individual paths (optional — all derived from BASE_DIR)
# GANJUUR_SCANS_DIR=/home/trinity/ganjuur/data/scans
# GANJUUR_CROPS_DIR=/home/trinity/ganjuur/data/ganjuur_crops/db_frames
# GANJUUR_VECTORDB=/home/trinity/ganjuur/vectordb
# GANJUUR_DB_PATH=/home/trinity/ganjuur/transliterations.db
# GANJUUR_MANUAL=/home/trinity/ganjuur/ganjuur_gariin_avlaga.html

# ── Snapshot / migration-ready archive ──────────────────────────────────────
GANJUUR_PROD_READY_BASE=/home/trinity/data/prod_ready_ganjuur

# Sudo password for brief docker stop during snapshot.
# Set the real value in .env only — never commit it.
GANJUUR_SUDO_PASS=

# ── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=

# ── Model / ingest ──────────────────────────────────────────────────────────
# GANJUUR_VECTOR_DIM=768
# GANJUUR_BATCH_SIZE=32
# GANJUUR_DEFAULT_STRIDE=50
# GANJUUR_DINO_MODEL=facebook/dinov2-base

# ── Safety limits ───────────────────────────────────────────────────────────
# GANJUUR_MAX_FILES=5000
# GANJUUR_MAX_ARCHIVE_BYTES=10737418240
# GANJUUR_MAX_MEMBER_BYTES=104857600
# GANJUUR_MAX_COMPRESSION=100
# GANJUUR_MAX_IMAGE_PIXELS=100000000
# GANJUUR_MAX_TOTAL_PIXELS=300000000

# ── Auth (required for production) ──────────────────────────────────────────
# GANJUUR_USER=
# GANJUUR_PASS=

# ── Gradio / server ─────────────────────────────────────────────────────────
# GANJUUR_HOST=0.0.0.0
# GANJUUR_PORT=7860
# GRADIO_ANALYTICS_ENABLED=false

# ── Галиг API (translit_api.py) ─────────────────────────────────────────────
# Write token for POST /api/translit/save (viewer sends X-Translit-token).
# Generate: openssl rand -hex 16   — if unset, writes are disabled (503).
# GANJUUR_TRANS_TOKEN=
# GANJUUR_API_PORT=7861
